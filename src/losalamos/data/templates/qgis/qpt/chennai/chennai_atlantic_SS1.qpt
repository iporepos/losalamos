        <Option value="with_variable(&#xd;&#xa;  'target_max', 3,&#xd;&#xa;  with_variable(&#xd;&#xa;    'extent', map_get(item_variables(@map_id), 'map_extent'),&#xd;&#xa;    with_variable(&#xd;&#xa;      'span', max(x_max(@extent) - x_min(@extent),&#xd;&#xa;                   y_max(@extent) - y_min(@extent)),&#xd;&#xa;      with_variable(&#xd;&#xa;        'raw_interval', @span / @target_max,&#xd;&#xa;        with_variable(&#xd;&#xa;          'exponent', floor(log(10, @raw_interval)),&#xd;&#xa;          with_variable(&#xd;&#xa;            'base', 10 ^ @exponent,&#xd;&#xa;            with_variable(&#xd;&#xa;              'normalized', @raw_interval / @base,&#xd;&#xa;              if(@normalized &lt;= 1, 1,&#xd;&#xa;                if(@normalized &lt;= 2, 2,&#xd;&#xa;                  if(@normalized &lt;= 5, 5, 10)&#xd;&#xa;                )&#xd;&#xa;              ) * @base&#xd;&#xa;            )&#xd;&#xa;          )&#xd;&#xa;        )&#xd;&#xa;      )&#xd;&#xa;    )&#xd;&#xa;  )&#xd;&#xa;)" type="QString" name="expression"/>
        <Option value="3" type="int" name="type"/>
